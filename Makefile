TARGET := iphone:clang:6.1:5.0
INSTALL_TARGET_PROCESSES = YouTube
ARCHS := armv7 armv7s

# Cydia on iOS 5/6 is happiest with gzip
THEOS_PLATFORM_DEB_COMPRESSION_TYPE = gzip

include $(THEOS)/makefiles/common.mk

include $(THEOS_MAKE_PATH)/tweak.mk

# The protobuf ObjC runtime vendored in lib/protobuf is v31.x (gencode
# 40311). protoc's ObjC generator must match it, so an older system
# protoc produces code the runtime rejects ("generated by an older
# version of protoc..."). The .pbobjc.* files are therefore committed
# pre-generated (with protoc 31.1) under common/SABR/proto/generated/,
# and we only invoke protoc when they're missing - so a mismatched
# system protoc never overwrites the known-good sources. Delete that
# folder (and use a matching protoc 31.x) if you edit the .proto files.
before-all::
	@if [ ! -f common/SABR/proto/generated/misc/Common.pbobjc.h ]; then \
		echo "Generating protobuf ObjC sources (protoc $$(protoc --version 2>/dev/null))"; \
		mkdir -p common/SABR/proto/generated; \
		protoc --proto_path=./common/SABR/proto/ --objc_out=common/SABR/proto/generated/ \
			common/SABR/proto/misc/* \
			common/SABR/proto/video_streaming/*; \
	fi

SUBPROJECTS += googleapp
SUBPROJECTS += preferences
SUBPROJECTS += classic
# SUBPROJECTS += classicapp
# SUBPROJECTS += captureapp
include $(THEOS_MAKE_PATH)/aggregate.mk
